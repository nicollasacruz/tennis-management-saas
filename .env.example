POSTGRES_DB=clubtenispro
POSTGRES_USER=clubtenispro
POSTGRES_PASSWORD=change_me_secret
DATABASE_URL=postgresql://clubtenispro:change_me_secret@postgres:5432/clubtenispro?schema=public
PORT=3000
# OBRIGATÓRIO em produção: sem JWT_SECRET a API não arranca (NODE_ENV=production).
# Use um valor longo e aleatório, único por ambiente. Em dev há fallback local.
JWT_SECRET=change-me-to-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:8080
WEB_PORT=8080
# Domínio raiz do SaaS. Cada escola fica em <slug>.clubtenispro.com.
SAAS_ROOT_DOMAIN=clubtenispro.com
DEFAULT_TENANT_SLUG=demo
# Base pública (site + onboarding). Usado para success_url/cancel_url do Stripe.
ONBOARDING_PUBLIC_BASE_URL=https://clubtenispro.com
# Stripe (assinatura mensal). Webhook: POST /api/onboarding/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Dono da plataforma (painel /gerencial). Criar com: npm --workspace apps/api run platform:create-owner
PLATFORM_OWNER_NAME=Dono SaaS
PLATFORM_OWNER_EMAIL=dono@clubtenispro.com
PLATFORM_OWNER_PASSWORD=change-me-to-a-strong-password
# Apex + wildcard para servir o site e os subdomínios de cada escola.
WEB_VIRTUAL_HOSTS=clubtenispro.com,*.clubtenispro.com
# TLS automático cobre o apex via HTTP-01. O wildcard (*.clubtenispro.com) exige
# certificado wildcard via DNS-01 (ou emissão por host) — configurar no acme-companion.
WEB_LETSENCRYPT_HOSTS=clubtenispro.com
LETSENCRYPT_EMAIL=admin@clubtenispro.com
RUN_SEED_ON_BOOT=false
RECEIPT_ISSUER=Clube de Ténis Demo
RECEIPT_SIGNATURE_LABEL=Direção do clube
BRAND_LOGO_URL=https://tiesports.s3.amazonaws.com/clubs/45940/logos/184a0513-da7c-418d-a7e8-a21b1f768fec.png
MAILU_PUBLIC_URL=https://mail.sarahcruz.pt
SMTP_ENABLED=true
SMTP_HOST=172.17.0.1
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=false
# Keep TLS certificate validation enabled by default.
# Set to false only in local development/tests with self-signed or otherwise invalid certificates.
SMTP_REJECT_UNAUTHORIZED=true
SMTP_USER=no-reply@clubtenispro.com
SMTP_PASSWORD="PASSWORD"
SMTP_FROM_EMAIL=no-reply@clubtenispro.com
SMTP_FROM_NAME=Clube de Ténis Demo
SMTP_REPLY_TO=no-reply@clubtenispro.com
EMAIL_QUEUE_WORKER_ENABLED=true
EMAIL_QUEUE_POLL_MS=5000
EMAIL_QUEUE_BATCH_SIZE=5
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_QUEUE_RETRY_BASE_SECONDS=60
EMAIL_QUEUE_STALE_AFTER_SECONDS=300
# EVOLUTION_API_BASE_URL é o servidor Evolution API PARTILHADO entre tenants.
# A partir da Fase 2 multitenant, a instância (id/token) é POR TENANT, gravada
# em TenantWhatsappConfig pelo painel WhatsApp de cada organização.
# EVOLUTION_API_INSTANCE_ID/TOKEN abaixo servem apenas de fallback/seed do tenant demo.
EVOLUTION_API_BASE_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHANGE_ME
EVOLUTION_API_INSTANCE_ID=CHANGE_ME
EVOLUTION_API_INSTANCE_TOKEN=CHANGE_ME
EVOLUTION_API_VIRTUAL_HOST=tenisevolution.clubtenispro.com
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=evolution_secret
PUBLIC_API_BASE_URL=https://demo.clubtenispro.com/api
RECEIPT_PUBLIC_TOKEN_SECRET=change-me-to-a-long-random-secret
WHATSAPP_QUEUE_WORKER_ENABLED=true
WHATSAPP_QUEUE_POLL_MS=5000
WHATSAPP_QUEUE_BATCH_SIZE=5
WHATSAPP_QUEUE_MAX_ATTEMPTS=3
WHATSAPP_QUEUE_RETRY_BASE_SECONDS=60
WHATSAPP_QUEUE_STALE_AFTER_SECONDS=300

PGADMIN_EMAIL=admin@clubtenispro.com
PGADMIN_PASSWORD=changeme
