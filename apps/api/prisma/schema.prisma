generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  MBWAY
  CASH
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WhatsappJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum FirstMonthBillingPolicy {
  PRORATA
  FULL_WITH_MAKEUP
}

enum StudentSex {
  FEMALE
  MALE
  OTHER
}

enum SystemUserRole {
  ADMIN
  HEAD_COACH
  COACH
  FINANCE
  DESK
}

enum AttendanceType {
  TENNIS
  PHYSICAL
}

enum TenantStatus {
  ACTIVE
  TRIALING
  SUSPENDED
  ARCHIVED
}

enum WhatsappConnectionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  primaryHost           String                 @unique
  status                TenantStatus           @default(ACTIVE)
  maxCourts             Int                    @default(3)
  logoUrl               String?
  receiptIssuer         String?
  receiptSignatureLabel String?
  systemUsers           SystemUser[]
  plans                 Plan[]
  students              Student[]
  payments              Payment[]
  receipts              Receipt[]
  attendances           Attendance[]
  activities            Activity[]
  statusHistories       StudentStatusHistory[]
  emailJobs             EmailJob[]
  whatsappJobs          WhatsappJob[]
  whatsappConfig        TenantWhatsappConfig?
  courts                Court[]
  classSlots            ClassSlot[]
  classEnrollments      ClassEnrollment[]
  classExceptions       ClassException[]
  stripeCustomerId      String?                @unique
  stripeSubscriptionId  String?                @unique
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

// Dono da plataforma (SaaS). NÃO pertence a nenhum tenant: vive no apex e gere
// todas as escolas no painel /gerencial. Auth totalmente separada do SystemUser
// (que é preso a um tenant), para não tocar no isolamento multitenant.
model PlatformUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  fullName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OnboardingStatus {
  PENDING
  COMPLETED
  FAILED
}

// Dados de uma tentativa de criação de escola (self-service no apex), entre o
// início do checkout e a confirmação de pagamento (webhook Stripe / mock).
model OnboardingSession {
  id                String           @id @default(cuid())
  schoolName        String
  slug              String
  adminName         String
  adminEmail        String
  passwordHash      String
  status            OnboardingStatus @default(PENDING)
  provider          String           @default("mock")
  providerSessionId String?          @unique
  stripeCustomerId  String?
  createdTenantId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([slug])
}

model TenantWhatsappConfig {
  id              String                   @id @default(cuid())
  tenantId        String                   @unique
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instanceId      String?
  instanceToken   String?
  instanceName    String?
  phoneNumber     String?
  status          WhatsappConnectionStatus @default(DISCONNECTED)
  lastConnectedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
}

model Plan {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name            String
  monthlyFeeCents Int
  sessionCount    Int?
  description     String?
  students        Student[]
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Student {
  id                      String                  @id @default(cuid())
  tenantId                String
  tenant                  Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fullName                String
  email                   String?
  phone                   String
  birthDate               DateTime?
  sex                     StudentSex?
  licenseNumber           String?
  doesPhysicalTraining    Boolean                 @default(false)
  taxId                   String?
  isMinor                 Boolean                 @default(false)
  responsibleName         String?
  responsibleTaxId        String?
  responsiblePhone        String?
  notes                   String?
  isActive                Boolean                 @default(true)
  currentPlanId           String?
  currentPlan             Plan?                   @relation(fields: [currentPlanId], references: [id], onDelete: SetNull)
  enrollmentStartDate     DateTime?
  enrollmentEndDate       DateTime?
  firstMonthBillingPolicy FirstMonthBillingPolicy @default(PRORATA)
  payments                Payment[]
  attendances             Attendance[]
  statusHistory           StudentStatusHistory[]
  classEnrollments        ClassEnrollment[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model SystemUser {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  fullName    String
  email       String
  password    String
  phone       String?
  role        SystemUserRole
  notes       String?
  isActive    Boolean        @default(true)
  classSlots  ClassSlot[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Payment {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId       String
  planId          String?
  description     String
  competencyMonth DateTime
  dueDate         DateTime
  paidAt          DateTime?
  amountCents     Int
  method          PaymentMethod?
  status          PaymentStatus  @default(PENDING)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan            Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  receipt         Receipt?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([tenantId])
  @@index([studentId, competencyMonth])
  @@index([status, dueDate])
}

model Receipt {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  paymentId String   @unique
  number    String
  issuedAt  DateTime @default(now())
  notes     String?
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([tenantId, number])
  @@index([tenantId])
}

model EmailJob {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  status              EmailJobStatus @default(PENDING)
  payload             Json
  referenceType       String?
  referenceId         String?
  attempts            Int            @default(0)
  maxAttempts         Int            @default(3)
  scheduledAt         DateTime       @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status, scheduledAt])
  @@index([tenantId, status, scheduledAt])
  @@index([referenceType, referenceId])
}

model WhatsappJob {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  status              WhatsappJobStatus @default(PENDING)
  payload             Json
  referenceType       String?
  referenceId         String?
  attempts            Int               @default(0)
  maxAttempts         Int               @default(3)
  scheduledAt         DateTime          @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  lastError           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, scheduledAt])
  @@index([tenantId, status, scheduledAt])
  @@index([referenceType, referenceId])
}

model Attendance {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId      String
  attendanceDate DateTime
  type           AttendanceType @default(TENNIS)
  classSlotId    String?
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSlot      ClassSlot?     @relation(fields: [classSlotId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([studentId, attendanceDate, type])
  @@index([tenantId])
  @@index([attendanceDate])
  @@index([classSlotId])
}

model Activity {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  title       String
  description String
  category    String
  startDate   DateTime
  endDate     DateTime?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([startDate])
}

model StudentStatusHistory {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId String
  isActive  Boolean
  startedAt DateTime
  endedAt   DateTime?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([studentId, startedAt])
}

enum ClassExceptionType {
  CANCELLED
  MOVED
}

// Court (quadra). Limite por tenant em Tenant.maxCourts.
model Court {
  id         String      @id @default(cuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name       String
  surface    String?
  isActive   Boolean     @default(true)
  sortOrder  Int         @default(0)
  classSlots ClassSlot[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Aula recorrente semanal num court. dayOfWeek 0=Dom..6=Sáb (JS getDay).
// Hora em minutos desde 00:00 (startMin/endMin).
model ClassSlot {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  courtId     String
  court       Court             @relation(fields: [courtId], references: [id], onDelete: Cascade)
  coachId     String?
  coach       SystemUser?       @relation(fields: [coachId], references: [id], onDelete: SetNull)
  title       String
  dayOfWeek   Int
  startMin    Int
  endMin      Int
  capacity    Int?
  isActive    Boolean           @default(true)
  enrollments ClassEnrollment[]
  exceptions  ClassException[]
  attendances Attendance[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([tenantId])
  @@index([courtId])
}

// Roster: aluno inscrito numa aula.
model ClassEnrollment {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classSlotId String
  classSlot   ClassSlot @relation(fields: [classSlotId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([classSlotId, studentId])
  @@index([tenantId])
}

// Override de uma ocorrência numa data concreta (cancelar ou mover).
model ClassException {
  id          String             @id @default(cuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  classSlotId String
  classSlot   ClassSlot          @relation(fields: [classSlotId], references: [id], onDelete: Cascade)
  date        DateTime
  type        ClassExceptionType
  newCourtId  String?
  newDate     DateTime?
  newStartMin Int?
  newEndMin   Int?
  reason      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([classSlotId, date])
  @@index([tenantId])
}
