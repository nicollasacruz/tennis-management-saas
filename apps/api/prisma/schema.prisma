generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  MBWAY
  CASH
  BANK_TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WhatsappJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum FirstMonthBillingPolicy {
  PRORATA
  FULL_WITH_MAKEUP
}

enum StudentSex {
  FEMALE
  MALE
  OTHER
}

enum SystemUserRole {
  ADMIN
  HEAD_COACH
  COACH
  FINANCE
  DESK
}

enum AttendanceType {
  TENNIS
  PHYSICAL
}

model Plan {
  id              String    @id @default(cuid())
  name            String    @unique
  monthlyFeeCents Int
  sessionCount    Int?
  description     String?
  students        Student[]
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Student {
  id                      String                  @id @default(cuid())
  fullName                String
  email                   String?                 @unique
  phone                   String
  birthDate               DateTime?
  sex                     StudentSex?
  licenseNumber           String?
  doesPhysicalTraining    Boolean                 @default(false)
  taxId                   String?
  isMinor                 Boolean                 @default(false)
  responsibleName         String?
  responsibleTaxId        String?
  responsiblePhone        String?
  notes                   String?
  isActive                Boolean                 @default(true)
  currentPlanId           String?
  currentPlan             Plan?                   @relation(fields: [currentPlanId], references: [id], onDelete: SetNull)
  enrollmentStartDate     DateTime?
  enrollmentEndDate       DateTime?
  firstMonthBillingPolicy FirstMonthBillingPolicy @default(PRORATA)
  payments                Payment[]
  attendances             Attendance[]
  statusHistory           StudentStatusHistory[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model SystemUser {
  id        String         @id @default(cuid())
  fullName  String
  email     String         @unique
  password  String
  phone     String?
  role      SystemUserRole
  notes     String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Payment {
  id              String         @id @default(cuid())
  studentId       String
  planId          String?
  description     String
  competencyMonth DateTime
  dueDate         DateTime
  paidAt          DateTime?
  amountCents     Int
  method          PaymentMethod?
  status          PaymentStatus  @default(PENDING)
  student         Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan            Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  receipt         Receipt?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([studentId, competencyMonth])
  @@index([status, dueDate])
}

model Receipt {
  id        String   @id @default(cuid())
  paymentId String   @unique
  number    String   @unique
  issuedAt  DateTime @default(now())
  notes     String?
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model EmailJob {
  id                  String         @id @default(cuid())
  status              EmailJobStatus @default(PENDING)
  payload             Json
  referenceType       String?
  referenceId         String?
  attempts            Int            @default(0)
  maxAttempts         Int            @default(3)
  scheduledAt         DateTime       @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  lastError           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([status, scheduledAt])
  @@index([referenceType, referenceId])
}

model WhatsappJob {
  id                  String            @id @default(cuid())
  status              WhatsappJobStatus @default(PENDING)
  payload             Json
  referenceType       String?
  referenceId         String?
  attempts            Int               @default(0)
  maxAttempts         Int               @default(3)
  scheduledAt         DateTime          @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  lastError           String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status, scheduledAt])
  @@index([referenceType, referenceId])
}

model Attendance {
  id             String         @id @default(cuid())
  studentId      String
  attendanceDate DateTime
  type           AttendanceType @default(TENNIS)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([studentId, attendanceDate, type])
  @@index([attendanceDate])
}

model Activity {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  startDate   DateTime
  endDate     DateTime?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
}

model StudentStatusHistory {
  id        String   @id @default(cuid())
  studentId String
  isActive  Boolean
  startedAt DateTime
  endedAt   DateTime?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, startedAt])
}
